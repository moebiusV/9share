; 9share.conf -- the configuration file of 9share(8), as an hbnf grammar over obconf.
;
; This is the source of src/9share_conf.c, which was generated from it by the hbnf parser
; generator meta compiler (https://github.com/moebiusV/hbnf).  The package does not need hbnf to be
; built: the generated file is committed.  To regenerate it see HACKING; in short, the grammar is
; self-contained (it includes no other file):
;
;     hbnf grammars/9share.hbnf --backend=c > 9share_conf.c
;
; and the runtime it links, hbnf's runtime/hbnf_conf.c and hbnf_conf.h, are in src/.
;
; The notation is obconf's: a block is a keyword, a name, and its settings between braces, a
; setting is a keyword and its argument, ended by the end of the line; strings may be put in double
; quotes; `#` starts a comment.  The meaning is in 9share.conf(5).  One grammar reads both files:
; an `export` block belongs in a user's ~/.config/9share/9share.conf and a `mount` block in
; /etc/9share/9share.conf; the program that reads a file uses the blocks that belong to it.

language C
prefix none
statements
keywords {
    export import mount directory host user at hold access
}
layout tailq
; phrase rules skip `ws` between their elements; character rules never do (defined below)
whitespace ws
{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/queue.h>
#include "9share_conf.h"
#include "hbnf_conf.h"

/* the configuration being filled in (nineshare_conf_parse sets it) */
static struct nineshare_conf *conf;

static char *dup_or_die(const char *v) {
    char *s = strdup(v);
    if (s == NULL) { perror("9share"); exit(1); }
    return s;
}
}

; -- 9share.conf ---------------------------------------------------------------------------

config = | config entry

entry  = "export" string "{" exportopts "}"
       | "import" string "{" importopts "}"
       | "mount" string "{" mountopts "}"

importopts = | importopts importopt
importopt  = "directory" string
           | "host" string
           | "hold" int

exportopts = | exportopts exportopt
exportopt  = "directory" string
           | "host" string
           | "hold" int

mountopts  = | mountopts mountopt
mountopt   = "user" string
           | "at" string
           | "hold" int
           | "access" string

; the checks and the effect of each block, in the order of the file; an error drops the block
action entry {
    if (n->kind == ENTRY_EXPORT) {
        struct nineshare_export e;
        exportopts_t *o;
        const char *err;
        memset(&e, 0, sizeof e);
        e.name = dup_or_die(n->string);
        e.line = n->_line;
        TAILQ_FOREACH(o, &n->exportopts, _link) {
            char **dst;
            if (o->exportopt.kind == EXPORTOPT_HOLD) {
                if (e.hold != 0) { bind_error("each setting may be given once"); goto drop_export; }
                e.hold = (int)o->exportopt.hyper_int;
                if (e.hold < 1 || e.hold > 86400) { bind_error("hold is a number of seconds, 1 to 86400"); e.hold = 0; goto drop_export; }
                continue;
            }
            dst = o->exportopt.kind == EXPORTOPT_DIRECTORY ? &e.directory : &e.host;
            if (*dst != NULL) { bind_error("each setting may be given once"); goto drop_export; }
            *dst = dup_or_die(o->exportopt.string);
        }
        err = nineshare_conf_add_export(conf, &e);
        if (err == NULL)
            return;
        bind_error("%s", err);
    drop_export:
        free(e.name); free(e.directory); free(e.host);
    } else if (n->kind == ENTRY_IMPORT) {
        struct nineshare_import e;
        importopts_t *o;
        const char *err;
        memset(&e, 0, sizeof e);
        e.name = dup_or_die(n->string);
        e.line = n->_line;
        TAILQ_FOREACH(o, &n->importopts, _link) {
            char **dst;
            if (o->importopt.kind == IMPORTOPT_HOLD) {
                if (e.hold != 0) { bind_error("each setting may be given once"); goto drop_import; }
                e.hold = (int)o->importopt.hyper_int;
                if (e.hold < 1 || e.hold > 86400) { bind_error("hold is a number of seconds, 1 to 86400"); e.hold = 0; goto drop_import; }
                continue;
            }
            dst = o->importopt.kind == IMPORTOPT_DIRECTORY ? &e.directory : &e.host;
            if (*dst != NULL) { bind_error("each setting may be given once"); goto drop_import; }
            *dst = dup_or_die(o->importopt.string);
        }
        err = nineshare_conf_add_import(conf, &e);
        if (err == NULL)
            return;
        bind_error("%s", err);
    drop_import:
        free(e.name); free(e.directory); free(e.host);
    } else {
        struct nineshare_mount m;
        mountopts_t *o;
        const char *err;
        memset(&m, 0, sizeof m);
        m.name = dup_or_die(n->string);
        m.line = n->_line;
        TAILQ_FOREACH(o, &n->mountopts, _link) {
            char **dst;
            if (o->mountopt.kind == MOUNTOPT_ACCESS) {
                if (m.access != 0) { bind_error("each setting may be given once"); goto drop_mount; }
                if (!strcmp(o->mountopt.string, "owner")) m.access = 1;
                else if (!strcmp(o->mountopt.string, "any")) m.access = 2;
                else { bind_error("access is owner (only the mount's user may use it) or any (every user of this machine)"); goto drop_mount; }
                continue;
            }
            if (o->mountopt.kind == MOUNTOPT_HOLD) {
                if (m.hold != 0) { bind_error("each setting may be given once"); goto drop_mount; }
                m.hold = (int)o->mountopt.hyper_int;
                if (m.hold < 1 || m.hold > 86400) { bind_error("hold is a number of seconds, 1 to 86400"); m.hold = 0; goto drop_mount; }
                continue;
            }
            dst = o->mountopt.kind == MOUNTOPT_USER ? &m.user : &m.at;
            if (*dst != NULL) { bind_error("each setting may be given once"); goto drop_mount; }
            *dst = dup_or_die(o->mountopt.string);
        }
        err = nineshare_conf_add_mount(conf, &m);
        if (err == NULL)
            return;
        bind_error("%s", err);
    drop_mount:
        free(m.name); free(m.user); free(m.at);
    }
}

; -- the obconf core -----------------------------------------------------------------------
; The lexical rules of obconf, hbnf's configuration language for OpenBSD-style files (keyword
; arguments, double-quoted strings, `#` comments, no interpolation), taken from hbnf's
; grammars/obconf.hbnf and common.hbnf (ISC licence, Copyright (c) 2026 David Walther) and
; written out here so that this file stands alone: it includes nothing.

; the character classes used (RFC 5234 appendix B.1 and the named ASCII characters)
DIGIT  = 0x30..0x39
ALPHA  = 0x41..0x5A | 0x61..0x7A
SP     = 0x20
HTAB   = 0x09
LF     = 0x0A
CR     = 0x0D
DQUOTE = 0x22

; a bareword may hold what a file name, a user name or a host name holds
wordchars  = ALPHA | DIGIT | "_" | "-" | "." | "/" | ":" | "@" | "+"
word_start = ALPHA | "_" | "-" | "/"
word_non_digit = word_start | "."

; `int` is declared before `word`, so that a bare number is an `int` (the scanner keeps the
; longest match, first declared on a tie)
int  = 1*DIGIT | "-" 1*DIGIT
word = word_start *wordchars | 1*DIGIT word_non_digit *wordchars

; a quoted string, with backslash escapes
str      = DQUOTE *str_char DQUOTE
str_char = 0x5C 0x00..0x10FFFF | 0x00..0x21 | 0x23..0x5B | 0x5D..0x10FFFF

; `#` to the end of the line; a backslash at the end of a line continues it
comment      = "#" *comment_char
comment_char = 0x01..0x09 | 0x0B..0x10FFFF
continuation = 0x5C LF

; what is skipped between the elements of a phrase: blanks, newlines, comments, continuations
ws = SP | HTAB | CR | LF | comment | continuation

string = str | word

{
#define HBNF_CONF_RUN
#include "hbnf_conf.h"

static int hbnf_parse_config(const char *path) {
    return hbnf_conf_run(path);
}

void nineshare_conf_init(struct nineshare_conf *c) {
    memset(c, 0, sizeof *c);
}

void nineshare_conf_free(struct nineshare_conf *c) {
    size_t i;
    for (i = 0; i < c->nexports; i++) {
        free(c->exports[i].name); free(c->exports[i].directory); free(c->exports[i].host);
    }
    for (i = 0; i < c->nimports; i++) {
        free(c->imports[i].name); free(c->imports[i].directory); free(c->imports[i].host);
    }
    for (i = 0; i < c->nmounts; i++) {
        free(c->mounts[i].name); free(c->mounts[i].user); free(c->mounts[i].at);
    }
    free(c->exports);
    free(c->mounts);
    free(c->imports);
    nineshare_conf_init(c);
}

/* hbnf's runtime stops the process at a syntax error unless the program takes the messages itself
   (hbnf_conf.h): 9share reports every error as "file:line: message" and returns -1. */
static void nineshare_conf_error(size_t line, const char *msg) {
    size_t l, col, off;
    int n = 0;
    if (sscanf(msg, "%zu:%zu:%zu: %n", &l, &col, &off, &n) >= 3 && n > 0)
        fprintf(stderr, "%s:%s\n", conf_file ? conf_file : "9share.conf", msg);
    else if (line)
        fprintf(stderr, "%s:%zu: %s\n", conf_file ? conf_file : "9share.conf", line, msg);
    else
        fprintf(stderr, "%s: %s\n", conf_file ? conf_file : "9share.conf", msg);
}

int nineshare_conf_parse(const char *path, struct nineshare_conf *c) {
    conf = c;
    conf_error = nineshare_conf_error;
    return hbnf_parse_config(path) == -1 ? -1 : 0;
}
}

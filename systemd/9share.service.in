[Unit]
Description=9share: share directories over 9P through ssh, and mount the ones sent to this machine
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=__BINDIR__/9share boot
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

bin_PROGRAMS = p9share

p9share_SOURCES = main.c cmds.c cmds.h serve.c boot.c util.c conf.c p9share.h p9share_conf.h \
                  p9share_conf.c hbnf_conf.c hbnf_conf.h

p9share_CPPFLAGS = -DP9SHARE_VERSION='"$(VERSION)"' -DP9SHARE_SYSCONFDIR='"$(sysconfdir)"' -DP9SHARE_DAUD='"$(sbindir)/daud"'

# p9share_conf.c is generated by hbnf (see HACKING); its code is not held to -Wextra
AM_CFLAGS = -Wall -Wextra -Wno-missing-field-initializers -Wno-unused-function

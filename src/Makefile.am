bin_PROGRAMS = 9share

9share_SOURCES = main.c cmds.c cmds.h serve.c boot.c relay.c util.c conf.c 9share.h 9share_conf.h \
                  9share_conf.c hbnf_conf.c hbnf_conf.h

9share_CPPFLAGS = -DNINESHARE_VERSION='"$(VERSION)"' -DNINESHARE_SYSCONFDIR='"$(sysconfdir)"' -DNINESHARE_DAUD='"$(sbindir)/daud"'

9share_LDADD = $(top_builddir)/daud/src/liblink/liblink.a

# 9share_conf.c is generated by hbnf (see HACKING); its code is not held to -Wextra
AM_CFLAGS = -Wall -Wextra -Wno-missing-field-initializers -Wno-unused-function
